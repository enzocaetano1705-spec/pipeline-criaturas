{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plano_cubos.schema.json",
  "title": "Plano de cubos (modelos/<nome>/eN/plano-cubos.json), entrada do gerador de ops",
  "type": "object",
  "required": ["nome", "resolucao", "ossos", "cubos"],
  "properties": {
    "nome": {"type": "string"},
    "formato": {"const": "bedrock"},
    "resolucao": {
      "type": "object", "required": ["largura", "altura"],
      "properties": {"largura": {"type": "integer"}, "altura": {"type": "integer"}}
    },
    "ossos": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nome", "pai", "pivo"],
        "properties": {
          "nome": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "pai": {"type": ["string", "null"]},
          "pivo": {"$ref": "comum.schema.json#/$defs/vec3"},
          "rotacao": {"$ref": "comum.schema.json#/$defs/vec3"}
        }
      }
    },
    "cubos": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nome", "osso", "from", "to"],
        "properties": {
          "nome": {"type": "string"},
          "osso": {"type": "string"},
          "parte": {"type": "string"},
          "tipo": {"$ref": "comum.schema.json#/$defs/tipo_parte"},
          "from": {"$ref": "comum.schema.json#/$defs/vec3"},
          "to": {"$ref": "comum.schema.json#/$defs/vec3"},
          "uv_offset": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
          "mirror_uv": {"type": "boolean"},
          "inflate": {"type": "number"},
          "cor": {"$ref": "comum.schema.json#/$defs/cor"}
        }
      }
    },
    "locators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nome", "osso", "posicao"],
        "properties": {
          "nome": {"type": "string", "pattern": "^loc_[a-z0-9_]+$"},
          "osso": {"type": "string"},
          "posicao": {"$ref": "comum.schema.json#/$defs/vec3"}
        }
      }
    },
    "orcamento": {
      "type": "object",
      "properties": {"cubos": {"type": "integer"}, "p75": {"type": "number"}, "limite": {"type": "number"}}
    }
  }
}
